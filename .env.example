# Supabase — fill from your project's API settings (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Server-only (never exposed to the browser). REQUIRED for the /admin dashboard
# (it reads every user's rows past row-level security). Project Settings → API.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin dashboard access — comma-separated emails allowed to see /admin.
# Anyone else is redirected to /dashboard. Defaults to c@serviche.com if unset.
ADMIN_EMAILS=c@serviche.com

# ReviewChaser SSO bridge (server-only). Values come from the reviewchaser
# Vercel project: its Supabase URL + service key, and the SAME LOGIN_SECRET
# it signs rc_session cookies with.
RC_SUPABASE_URL=https://REVIEWCHASER-project-ref.supabase.co
RC_SERVICE_ROLE_KEY=reviewchaser-service-role-key
RC_LOGIN_SECRET=same-value-as-reviewchaser-LOGIN_SECRET
# Optional override for the proxied ReviewChaser deployment (build-time)
# RC_APP_ORIGIN=https://reviewchaser.vercel.app
